{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": [
                "day${input:day}",
                "puzzle${input:puzzle}"
            ]
        },
    ],
    "inputs": [
        {
            "id": "day",
            "type": "promptString",
            "description": "Enter the day number (e.g., 1, 2, 3, ...)",
            "default": "1"
        },
        {
            "id": "puzzle",
            "type": "promptString",
            "description": "Enter the puzzle number (e.g., 1 or 2)",
            "default": "1"
        }
    ]
}